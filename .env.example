# Local development only. NEVER commit a real .env. In production these are set in Railway (Variables).
# Admin connection used ONLY by the migration step (hosting-provider superuser). On Railway: reference the Postgres service.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/tijara
# Passwords for the three NOSUPERUSER/NOBYPASSRLS roles created by the migration step (>= 16 chars, random, different from each other)
APP_OWNER_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_PLATFORM_PASSWORD=
APP_ENV=production
PORT=3000
